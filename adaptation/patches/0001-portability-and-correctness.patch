-    if (broadc < 999 && (r & (perm_rotate|perm_shright|perm_shleft|perm_rotate_big)) == 0) {
-        r |= perm_broadcast | (uint64_t)broadc << perm_rot_count; // fits broadcast
-    }
-    return r;
-}
